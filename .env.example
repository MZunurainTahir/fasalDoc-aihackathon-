# Copy this file to .env (for local dev) and set the real values in your
# hosting provider's dashboard for production (Vercel/Netlify env vars).
# Everything here is PUBLIC once built — never put secret API keys in this
# file. Model provider keys (Groq/OpenRouter/etc.) belong in backend/.env.

# URL of the FasalDoc backend (see backend/ folder). Leave empty to run the
# app in fully offline/mock mode with no backend at all.
VITE_API_URL=http://localhost:8000

# Supabase project — create a free project at https://supabase.com,
# run supabase/schema.sql in the SQL editor, then paste your values here.
# The anon key is safe to expose publicly (Row Level Security protects data).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenWeatherMap API key for real weather disease-risk forecasts.
# Get a free key at https://openweathermap.org/api. If omitted, realistic
# mock weather data for the selected Pakistani city is used.
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: real-time mandi rates endpoint (fallback data is used if empty).
VITE_MARKET_RATES_API_URL=https://api.example.com/mandi

# Optional: VAPID public key for push notifications.
VITE_PUSH_NOTIFICATIONS_PUBLIC_KEY=your_vapid_public_key_here
