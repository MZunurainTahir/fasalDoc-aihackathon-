# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it's already in .gitignore.

# ── Server ──
PORT=8000
# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN=https://fasaldoc.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# ── LLM Provider (at least one is required for real AI responses) ──
# Groq is used first (fast + generous free tier, supports vision models).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Current recommended Groq models as of Aug 2026 — llama-3.3-70b-versatile
# and llama-4-scout were deprecated by Groq in June 2026. If you hit a
# "model_decommissioned" error, check https://console.groq.com/docs/deprecations
# for the latest replacement and update these two values.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# OpenRouter is used automatically as a fallback if Groq fails or is unset.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001

# Not currently wired up, kept for future use (e.g. LLM-based Urdu polishing).
GEMINI_API_KEY=

# If no API key is set at all, the backend automatically serves realistic
# mock diagnoses/replies so the app still fully functions for a demo.
